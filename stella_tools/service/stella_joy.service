[Unit]
Description=STELLA N5 Joystick Teleop
After=stella_bringup.service
Requires=stella_bringup.service

[Service]
Type=simple
User=__USER__
EnvironmentFile=__REPO_DIR__/stella_tools/config/robot.env
Environment="FASTRTPS_DEFAULT_PROFILES_FILE=__REPO_DIR__/stella_tools/config/fastdds_peers.xml"
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash -c '\
  source /opt/ros/jazzy/setup.bash && \
  source __HOME__/colcon_ws/install/local_setup.bash && \
  source __HOME__/jazzy_ws/install/local_setup.bash && \
  ros2 launch __REPO_DIR__/stella_tools/joystick/stella_joy_launch.py robot_ns:=${ROBOT_NS}'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
