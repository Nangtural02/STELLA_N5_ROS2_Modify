[Unit]
Description=STELLA N5 Bringup
After=network.target

[Service]
Type=simple
User=stella2
Environment="ROS_DOMAIN_ID=52"
ExecStart=/bin/bash -c '\
  source /opt/ros/jazzy/setup.bash && \
  source /home/stella2/colcon_ws/install/local_setup.bash && \
  source /home/stella2/jazzy_ws/install/local_setup.bash && \
  export TAPPAS_POST_PROC_DIR=/usr/lib/aarch64-linux-gnu/hailo/tappas/post_processes && \
  ros2 launch stella_bringup robot.launch.py robot_ns:=robot2'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
