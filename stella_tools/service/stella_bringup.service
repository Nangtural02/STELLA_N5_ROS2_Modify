[Unit]
Description=STELLA N5 Bringup
After=network.target

[Service]
Type=simple
User=__USER__
EnvironmentFile=__REPO_DIR__/stella_tools/config/robot.env
ExecStart=/bin/bash -c '\
  source /opt/ros/jazzy/setup.bash && \
  source __HOME__/colcon_ws/install/local_setup.bash && \
  source __HOME__/jazzy_ws/install/local_setup.bash && \
  export TAPPAS_POST_PROC_DIR=/usr/lib/aarch64-linux-gnu/hailo/tappas/post_processes && \
  ros2 launch stella_bringup robot.launch.py robot_ns:=${ROBOT_NS}'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
